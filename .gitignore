# This .gitignore is based on the Flutter default and app-specific generated files.

# Flutter/Dart/Pub related
.dart_tool/
.packages
.pub-cache/
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies

# IntelliJ related
.idea/
*.iml
*.ipr
*.iws

# VS Code related
.vscode/

# macOS
.DS_Store

# Android/iOS related generated files
android/.gradle/
android/local.properties
android/key.properties
android/**/GeneratedPluginRegistrant.java
ios/Pods/
ios/Runner.xcworkspace/
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh

# Environment files
.env
.env.*

# Logs
*.log
